name: "yolov8_onnx"
platform: "onnxruntime_onnx"
max_batch_size: 1

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 3, 640, 640 ]
  }
]

output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [ 8400, 6 ]
  }
]

# Dynamic batching for better throughput
dynamic_batching {
  preferred_batch_size: [ 1  ]
  max_queue_delay_microseconds: 1000
}

# GPU instance configuration
instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]

 

 
 
